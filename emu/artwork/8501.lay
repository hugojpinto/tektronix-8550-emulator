<!-- Tektronix 8501 Data Management Unit, front panel. Drawn after photos of a real unit (the owner's,
     from the VCFed thread "Tektronix 85xx MDL system", and sources/tekwiki/8550/8550_1.jpg): two Qume
     8" drives stacked on the left (slot band with DRIVE 0/1, latch bar, red activity lamp), grilles and
     the control panel on the right: ON (green) + DC rocker | AC ON, PROCESSOR BUSY | RESTART, HALT/RUN.
     The five diagnostic LEDs are inside, on the Utility board (061-2355-00): shown on a strip below. -->
<mamelayout version="2">
<element name="frame"><rect><color red="0.66" green="0.65" blue="0.6"/></rect></element>
<element name="face"><rect><color red="0.86" green="0.85" blue="0.8"/></rect></element>
<element name="recess"><rect><color red="0.8" green="0.79" blue="0.73"/></rect></element>
<element name="strip"><rect><color red="0.9" green="0.89" blue="0.85"/></rect></element>
<element name="panel"><rect><color red="0.88" green="0.88" blue="0.85"/></rect><rect><color red="0.7" green="0.7" blue="0.68"/><bounds x="0" y="0" width="100" height="1"/></rect></element>
<element name="divider"><rect><color red="0.62" green="0.62" blue="0.6"/></rect></element>
<element name="led_red"><disk state="0"><color red="0.3" green="0.07" blue="0.05"/></disk><disk state="1"><color red="1" green="0.2" blue="0.1"/></disk></element>
<element name="led_green"><disk state="0"><color red="0.07" green="0.22" blue="0.12"/></disk><disk state="1"><color red="0.3" green="1" blue="0.45"/></disk></element>
<element name="toggle"><rect><color red="0.08" green="0.08" blue="0.09"/><bounds x="0" y="0" width="10" height="12"/></rect><rect state="0"><color red="0.3" green="0.3" blue="0.32"/><bounds x="2" y="1.5" width="6" height="4.5"/></rect><rect state="1"><color red="0.3" green="0.3" blue="0.32"/><bounds x="2" y="6" width="6" height="4.5"/></rect><rect state="0"><color red="0.55" green="0.55" blue="0.57"/><bounds x="3" y="2" width="4" height="1.2"/></rect><rect state="1"><color red="0.55" green="0.55" blue="0.57"/><bounds x="3" y="9" width="4" height="1.2"/></rect></element>
<element name="rocker_v"><rect><color red="0.05" green="0.05" blue="0.06"/><bounds x="0" y="0" width="10" height="17"/></rect><rect><color red="0.16" green="0.16" blue="0.17"/><bounds x="1.2" y="1.2" width="7.6" height="14.6"/></rect><rect state="1"><color red="0.24" green="0.24" blue="0.25"/><bounds x="1.2" y="1.2" width="7.6" height="6"/></rect><rect state="0"><color red="0.24" green="0.24" blue="0.25"/><bounds x="1.2" y="9.8" width="7.6" height="6"/></rect></element>
<element name="inset"><rect><color red="0.72" green="0.72" blue="0.7"/></rect></element>
