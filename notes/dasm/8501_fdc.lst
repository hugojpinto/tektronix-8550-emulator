; Tektronix 8501 Flexible Disc Controller firmware, ROM 160-0412-00 (U2030 on A50, 4096 x 8).
; Z80A at 4 MHz. Memory map and register semantics: notes/8501-fdc.md.
; Disassembled with emu/build/dasm z80 per code region; tables decoded by hand.

; reset: SP=2400; HSR1 bit 0 = 0 -> board self-test at 0FB5
0000: 31 00 24     ld   sp,$2400
0003: 3a 00 a0     ld   a,($A000)
0006: 1f           rra
0007: 30 37        jr   nc,$0040
0009: 11 43 20     ld   de,$2043
000c: 3e 01        ld   a,$01
000e: 12           ld   (de),a
000f: 3a 0c e0     ld   a,($E00C)
0012: db 00        in   a,($00)
0014: 06 5a        ld   b,$5A
0016: cd 67 02     call $0267
0019: af           xor  a
001a: 32 6b 20     ld   ($206B),a
001d: 32 3d 20     ld   ($203D),a
0020: 32 3e 20     ld   ($203E),a
0023: 32 00 40     ld   ($4000),a
0026: 32 00 60     ld   ($6000),a
0029: 06 18        ld   b,$18
002b: 21 10 20     ld   hl,$2010
002e: 77           ld   (hl),a
002f: 23           inc  hl
0030: 10 fc        djnz $002E
0032: ed 56        im   1
0034: 1a           ld   a,(de)
0035: b7           or   a
0036: 18 03        jr   $003B

; INT (IM 1): SCF; RETI -- aborts transfer loops through carry
0038: 37           scf
0039: ed 4d        reti
003b: 28 29        jr   z,$0066
003d: af           xor  a
003e: 12           ld   (de),a
003f: 76           halt
0040: c3 b5 0f     jp   $0FB5
0043: 01 00 00     ld   bc,$0000
0046: ed 53 04 e0  ld   ($E004),de
004a: 3e 0c        ld   a,$0C
004c: cd 5c 00     call $005C
004f: 2a 0a e0     ld   hl,($E00A)
0052: 13           inc  de
0053: 1f           rra
0054: cd 5c 00     call $005C
0057: 2a 08 e0     ld   hl,($E008)
005a: 18 ea        jr   $0046
005c: 32 00 60     ld   ($6000),a
005f: ed 43 06 e0  ld   ($E006),bc
0063: c3 64 02     jp   $0264

; NMI: the LSI-11 wrote CBPR (a new command)
0066: 21 43 20     ld   hl,$2043
0069: cb 46        bit  0,(hl)
006b: 28 04        jr   z,$0071
006d: cb 86        res  0,(hl)
006f: ed 4d        reti
0071: 2a 0a e0     ld   hl,($E00A)
