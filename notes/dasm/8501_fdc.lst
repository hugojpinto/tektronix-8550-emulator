; command end: E00C, write back, DONE, interrupt (E104 = vector 230)
016e: 3a 00 80     ld   a,($8000)
0171: 32 48 20     ld   ($2048),a
0174: 21 3d 20     ld   hl,$203D
0177: 7e           ld   a,(hl)
