; decode FDCR command and drive
01aa: 3a 02 20     ld   a,($2002)
01ad: e6 3f        and  $3F
01af: 21 f9 01     ld   hl,$01F9
01b2: 01 0a 00     ld   bc,$000A
01b5: ed b1        cpir
01b7: 20 38        jr   nz,$01F1
01b9: 09           add  hl,bc
01ba: 09           add  hl,bc
01bb: 09           add  hl,bc
01bc: 09           add  hl,bc
01bd: 4e           ld   c,(hl)
01be: 23           inc  hl
01bf: 46           ld   b,(hl)
01c0: ed 43 3f 20  ld   ($203F),bc
01c4: 23           inc  hl
01c5: 7e           ld   a,(hl)
01c6: 32 41 20     ld   ($2041),a
01c9: 3a 03 20     ld   a,($2003)
01cc: e6 0c        and  $0C
01ce: 0f           rrca
01cf: 0f           rrca
