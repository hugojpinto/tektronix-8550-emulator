; command table: 10 codes (041..063 octal), then 10 x {handler, flags} in reverse order
01f9: .db 21 23 25 27 29 2b 2d 2f
0201: .db 31 33 cc 0e 20 59 09 02
0209: .db 06 05 00 1c 05 00 0a 05
0211: .db 10 a8 0b 08 a2 0b 08 4c
0219: .db 05 04 5d 09 02 4c 05 01

; read the 8-word command block (DMA E006 -> E008)
0221: 21 3e 20     ld   hl,$203E
0224: 7e           ld   a,(hl)
0225: e6 97        and  $97
0227: 77           ld   (hl),a
0228: 32 00 60     ld   ($6000),a
022b: 2a 00 20     ld   hl,($2000)
